# Copy to .env for local use. On Railway, set these in the service's Variables tab instead (never commit .env).
# Nothing marked optional is required: without keys the engine runs on its rules extractor.

# --- Auth (REQUIRED on Railway; the app refuses to start publicly without it). Password only, no username. ---
AUTH_PASSWORD=

# --- Optional integrations ---
# Gemini (free key: https://aistudio.google.com/apikey). Turns on LLM extraction, outreach angles and agent query planning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Strongly recommended on Railway: anonymous Reddit RSS is often blocked from datacenter IPs.
# Free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Server ---
# Railway injects PORT itself; only set it locally (default 4300).
PORT=4300
# HOST=            unset = loopback locally, all interfaces when on Railway
# DB_PATH=         unset = data/leadintel.db locally, <volume>/leadintel.db on Railway when a volume is attached
# DISABLE_AGENT=1
# QUIET=1
# ALLOW_NO_AUTH=1  escape hatch to run publicly without auth (not recommended)
